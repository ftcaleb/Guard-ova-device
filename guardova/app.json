{
  "expo": {
    "name": "Guard'Ova",
    "slug": "guardova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "guardova",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ftcaleb.guardova"
    },
    "android": {
      "package": "com.ftcaleb.guardova",
      "adaptiveIcon": {
        "backgroundColor": "#E9F3EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/DMSans-400.ttf",
            "./assets/fonts/DMSans-450.ttf",
            "./assets/fonts/DMSans-500.ttf",
            "./assets/fonts/DMSans-550.ttf",
            "./assets/fonts/DMSans-600.ttf",
            "./assets/fonts/DMSans-650.ttf",
            "./assets/fonts/DMSans-700.ttf",
            "./assets/fonts/Manrope-400.ttf",
            "./assets/fonts/Manrope-500.ttf",
            "./assets/fonts/Manrope-600.ttf",
            "./assets/fonts/Manrope-650.ttf",
            "./assets/fonts/Manrope-700.ttf",
            "./assets/fonts/Manrope-750.ttf",
            "./assets/fonts/Manrope-800.ttf",
            "./assets/fonts/Inter-400.ttf"
          ]
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
